<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NotePadMod</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <NoWarn>$(NoWarn);CS0436;CS0618</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <AmongUsDir>/Users/neiljain/Library/Application Support/CrossOver/Bottles/Among Us/drive_c/Program Files (x86)/Steam/steamapps/common/Among Us</AmongUsDir>
  </PropertyGroup>

  <!-- Lokala referenser -->
  <ItemGroup>
    <PackageReference Include="TownOfUsMira" Version="1.6.2" />
        <PackageReference Include="AllOfUs.MiraAPI" Version="0.4.0" />
        <PackageReference Include="Reactor" Version="2.5.0-ci.371" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="AmongUs.GameLibs.Android" Version="2026.3.17" />
        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.0.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\notepad_inactive.png" />
    <EmbeddedResource Include="Resources\notepad_active.png" />
    <EmbeddedResource Include="Resources\notepad_window.png" />
    <EmbeddedResource Include="Resources\notepad_window_black.png" />
    <EmbeddedResource Include="Resources\notepad_clear.png" />
    <EmbeddedResource Include="Resources\notepad_clear_hover.png" />
    <EmbeddedResource Include="Resources\notepad_logo.png" />
    <EmbeddedResource Include="modinfo.json" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <MakeDir Directories="$(AmongUsDir)\BepInEx\plugins\" />
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(AmongUsDir)\BepInEx\plugins\"
      SkipUnchangedFiles="false" />
    <Message Text="DLL kopierad till plugins!" Importance="high" />
  </Target>
</Project>
