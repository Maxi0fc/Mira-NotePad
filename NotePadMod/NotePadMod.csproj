<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NotePadMod</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <Version>1.4.5</Version>
    <NoWarn>$(NoWarn);CS0436;CS0618</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GamePlatform Condition="'$(GamePlatform)' == ''">Steam</GamePlatform>
    <AssemblyName Condition="'$(GamePlatform)' == 'Android'">NotePadMod-Android</AssemblyName>
  </PropertyGroup>

  <!-- Lokala referenser -->
  <ItemGroup>
  <PackageReference Include="TownOfUsMira" Version="1.7.9-beta1" />
  <PackageReference Include="AllOfUs.MiraAPI" Version="0.6.0"/>
  <PackageReference Include="Reactor" Version="2.5.1-ci.384"/>  <!-- Changed from 2.5.1 -->
  <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
  <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" Condition="'$(GamePlatform)' != 'Android'" />
  <PackageReference Include="AmongUs.GameLibs.Android" Version="2026.9.29" Condition="'$(GamePlatform)' == 'Android'" />
  <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
  <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.0.1" PrivateAssets="all" ExcludeAssets="runtime" />
</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\JotButton.png" />
    <EmbeddedResource Include="Resources\notepad_logo.png" />
    <EmbeddedResource Include="Resources\general_tab.png" />
    <EmbeddedResource Include="Resources\roles_tab.png" />
    <EmbeddedResource Include="Resources\DeleteInfoButton.png" />
    <EmbeddedResource Include="Resources\notepad-mod-win.bundle" Condition="'$(GamePlatform)' != 'Android'" />
    <EmbeddedResource Include="Resources\notepad-mod-android.bundle" Condition="'$(GamePlatform)' == 'Android'" />
    <EmbeddedResource Include="modinfo.json" />
  </ItemGroup>

</Project>
